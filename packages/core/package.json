{
  "name": "@moneta/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain types and logic. No UI frameworks, no backend imports.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "default": "./dist/document.js"
    },
    "./document-list": {
      "types": "./dist/document-list.d.ts",
      "default": "./dist/document-list.js"
    },
    "./document-patch": {
      "types": "./dist/document-patch.d.ts",
      "default": "./dist/document-patch.js"
    },
    "./document-upload": {
      "types": "./dist/document-upload.d.ts",
      "default": "./dist/document-upload.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    }
  }
}
