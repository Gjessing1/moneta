# Copy to .env for local dev. In production the real .env lives in
# /home/gjessing/docker/Productivity/moneta/.env next to the deploy compose file.

# HTTP port. 3000 is Forgejo on this host, so every app gets its own.
PORT=3047
# Persistent data (SQLite, uploads). Container path; bind-mounted from the host.
MONETA_DATA_DIR=./data
LOG_LEVEL=info

# maily, the source of mail-borne receipts and invoices. Locally its dev or host port;
# in the container use http://host.docker.internal:3060 (a separate compose stack).
MAILY_URL=http://127.0.0.1:3060
# maily as the browser reaches it, for "open in maily" links on a document.
MAILY_PUBLIC_URL=https://mail.gjessing.io

# Secrets live here only — never shipped to clients.
# JWT_SECRET=change-me-to-a-long-random-string
